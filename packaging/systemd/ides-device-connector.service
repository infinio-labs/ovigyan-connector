[Unit]
Description=IDeS attendance device connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ides-connector
Group=ides-connector
StateDirectory=ides-device-connector
WorkingDirectory=/var/lib/ides-device-connector
EnvironmentFile=/etc/ides-device-connector.env
Environment=ATTENDANCE_OUTBOX_PATH=/var/lib/ides-device-connector/outbox.db
ExecStart=/usr/local/bin/ides-device-connector
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ides-device-connector

[Install]
WantedBy=multi-user.target
